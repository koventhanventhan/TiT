APP_NAME=TiT Education
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

PUSHER_APP_ID="2123529"
PUSHER_APP_KEY="your_pusher_app_key_here"
PUSHER_APP_SECRET="your_pusher_app_secret_here"
PUSHER_APP_CLUSTER=ap2

VITE_PUSHER_APP_KEY="your_vite_pusher_app_key_here"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GEMINI_API_KEY=your_gemini_api_key_here

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_IS_SANDBOX=true

MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATION_CHANNEL=auto
WHATSAPP_ENABLED=false
