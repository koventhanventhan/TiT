<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="BROADCAST_DRIVER" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_FOREIGN_KEYS" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Safe baseline: All integration credentials forced empty in testing environment -->
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="ZOOM_CLIENT_ID" value="" force="true"/>
        <env name="ZOOM_CLIENT_SECRET" value="" force="true"/>
        <env name="ZOOM_ACCOUNT_ID" value="" force="true"/>
        <env name="ZOOM_HOST_EMAIL" value="" force="true"/>
        <env name="RECAPTCHA_SITE_KEY" value="" force="true"/>
        <env name="RECAPTCHA_SECRET_KEY" value="" force="true"/>
        <env name="GOOGLE_CLIENT_ID" value="" force="true"/>
        <env name="GOOGLE_CLIENT_SECRET" value="" force="true"/>
        <env name="GOOGLE_REDIRECT_URI" value="" force="true"/>
        <env name="PAYHERE_MERCHANT_ID" value="" force="true"/>
        <env name="PAYHERE_MERCHANT_SECRET" value="" force="true"/>
        <env name="PAYHERE_APP_ID" value="" force="true"/>
        <env name="PAYHERE_APP_SECRET" value="" force="true"/>
        <env name="WHATSAPP_TOKEN" value="" force="true"/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value="" force="true"/>
        <env name="META_WHATSAPP_TOKEN" value="" force="true"/>
        <env name="META_WHATSAPP_PHONE_NUMBER_ID" value="" force="true"/>
        <env name="MAIL_HOST" value="" force="true"/>
        <env name="MAIL_PORT" value="" force="true"/>
        <env name="MAIL_USERNAME" value="" force="true"/>
        <env name="MAIL_PASSWORD" value="" force="true"/>
        <env name="MAIL_ENCRYPTION" value="" force="true"/>
        <env name="MAIL_FROM_ADDRESS" value="" force="true"/>
        <env name="MAIL_FROM_NAME" value="" force="true"/>
    </php>
</phpunit>
