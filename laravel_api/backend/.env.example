APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Integration
WHATSAPP_ENABLED=false

# Firebase Storage & Auth (Admin Uploads)
# Note: FIREBASE_PRIVATE_KEY must be on one single line with literal \n escapes enclosed in quotes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Gemini & Student AI Study Assistant (RAG)
GEMINI_API_KEY=
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_LLM_MODEL=gemini-3.8-flash
RAG_OCR_MODEL=gemini-3.8-flash
RAG_OCR_FALLBACK_MODEL=gemini-3.5-flash-lite
RAG_OCR_TEMPERATURE=0.0
RAG_OCR_PAGE_TIMEOUT=120
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=5
RAG_RATE_LIMIT_PER_MINUTE=10
RAG_DAILY_QUESTION_LIMIT=30
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_OUTPUT_TOKENS=1500
RAG_LLM_REQUEST_TIMEOUT=45

# Gemini Child Safety Filter Thresholds
RAG_SAFETY_HARASSMENT=BLOCK_LOW_AND_ABOVE
RAG_SAFETY_HATE_SPEECH=BLOCK_LOW_AND_ABOVE
RAG_SAFETY_SEXUALLY_EXPLICIT=BLOCK_LOW_AND_ABOVE
RAG_SAFETY_DANGEROUS_CONTENT=BLOCK_LOW_AND_ABOVE

# Student Distress Helplines (Empty by default; supply verified numbers)
RAG_HELPLINE_PRIMARY_NAME=
RAG_HELPLINE_PRIMARY_NUMBER=
RAG_HELPLINE_PRIMARY_HOURS=
RAG_HELPLINE_SECONDARY_NAME=
RAG_HELPLINE_SECONDARY_NUMBER=
RAG_HELPLINE_SECONDARY_HOURS=
RAG_HELPLINE_INSTITUTE_NAME="Institute / Teacher Support"
RAG_HELPLINE_INSTITUTE_NUMBER=
RAG_HELPLINE_INSTITUTE_HOURS=

# Legacy-Font Mojibake & Script Detection
RAG_LEGACY_FONT_MIN_SCRIPT_RATIO=0.20
RAG_LEGACY_FONT_MIN_LETTERS=50# Google Gemini & Student AI Study Assistant (RAG)
GEMINI_API_KEY=
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_LLM_MODEL=gemini-3.8-flash
RAG_OCR_MODEL=gemini-3.8-flash
RAG_OCR_FALLBACK_MODEL=gemini-3.5-flash-lite
RAG_OCR_TEMPERATURE=0.0
RAG_OCR_PAGE_TIMEOUT=120
RAG_OCR_TOTAL_TIMEOUT=120
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=5
RAG_RATE_LIMIT_PER_MINUTE=10
RAG_DAILY_QUESTION_LIMIT=30
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_OUTPUT_TOKENS=1500
RAG_LLM_REQUEST_TIMEOUT=45
RAG_429_MAX_ATTEMPTS=4
