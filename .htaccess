# =====================================================================
# LIVE .htaccess Configuration Notice
# NOTE: The LIVE .htaccess on the production server (titjaffna.lk) is
# maintained by hand on the server (deploy.sh / git deployments do not overwrite it).
#
# The live file MUST contain:
#   1. Force HTTPS and canonical host redirects.
#   2. Static files & existing directories bypass: -f / -d -> [L].
#   3. API routing rule: /api
#   4. Backend routing rule: /admin|super-panel|livewire (added by owner)
#   5. Sitemap routing rule: /sitemap.xml
#   6. SPA fallback: Everything else routes to index.html
#
# See docs/DEPLOYMENT.md for the complete recommended live configuration.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.titjaffna\.lk$ [NC]
    RewriteRule ^(.*)$ https://titjaffna.lk%{REQUEST_URI} [L,R=301]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 1. Real files/folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Route Laravel Backend ONLY (Admin Blade, API, Super-Panel, Livewire, Sitemap)
    RewriteCond %{REQUEST_URI} ^/(admin|api|super-panel|livewire|sitemap\.xml) [NC]
    RewriteRule ^(.*)$ laravel_api/backend/public/index.php [QSA,L]

    # 3. Everything else (Frontend, Student Dashboard, Teacher Dashboard) goes to React
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
